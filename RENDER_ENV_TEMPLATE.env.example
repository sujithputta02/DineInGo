# ============================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# Copy into Render → your service → Environment
# NEVER put real secrets in this file or commit them.
# Generate strong random values for secrets (e.g. openssl rand -hex 32).
# ============================================

# --- Core App settings ---
PORT=8080
NODE_ENV=production
# Paste Atlas connection string from your host dashboard only.
# Do not commit credentials. Leave blank in this template.
MONGODB_URI=
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ADMIN_CODE=REPLACE_WITH_STRONG_ADMIN_CODE

# --- Frontend Links (Update with your Vercel URL) ---
FRONTEND_URL=https://your-app.vercel.app
ADMIN_URL=https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app

# --- Email Service (Gmail SMTP) ---
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password

# --- Email Service (Brevo Fallback) ---
BREVO_API_KEY=your_brevo_api_key
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# --- AI Chatbot (Sarvam/OpenRouter) ---
SARVAM_API_KEY=your_sarvam_key
SARVAM_MODEL=sarvam-m
OPENROUTER_API_KEY=your_openrouter_key
AI_MODEL=google/gemma-3n-e4b-it:free
PRIMARY_LLM_PROVIDER=sarvam

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
